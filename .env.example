# ─────────────────────────────────────────────────────────────────────────────
# ARFINITY Studio: environment variables
#
# Copy this file to .env for local development only. NEVER commit .env.
# In production, set these in Netlify: Site configuration → Environment variables.
# Use placeholders here, never real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Free tier). Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public anon key. The current code does not use it (the browser never calls Supabase directly).
# Kept so the project matches the agreed variable list and for a future read-only client.
SUPABASE_ANON_KEY=your-anon-key-here
# SERVER-SIDE ONLY. Bypasses RLS. Never put it in HTML, JS, or a NEXT_PUBLIC/VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (Free tier). resend.com → API Keys.
RESEND_API_KEY=re_your_resend_api_key_here
# Where new-lead notifications go (the ARFINITY team inbox).
ADMIN_NOTIFICATION_EMAIL=team@your-domain.com
# Sender address. Must be on a domain you verified in Resend. Leave unset to use onboarding@resend.dev,
# which only delivers to the email address on your Resend account (fine for testing).
RESEND_FROM_EMAIL=ARFINITY Leads <leads@your-verified-domain.com>

# Protects POST /.netlify/functions/notify-pending (re-sends failed notifications). Use 24+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=generate-a-long-random-string-of-at-least-24-chars
